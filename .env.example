# Analytics (Plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=alexander-ergart.de

# ---------------------------------------------------------------------------
# reCAPTCHA v3
# ---------------------------------------------------------------------------
# Site Key: oeffentlich, wird NUR im Browser verwendet (src/lib/recaptcha-client.ts).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Secret Key: NUR serverseitig (beide Routen unter src/app/api/leads).
# PFLICHT - ohne diesen Wert weisen beide Routen Anfragen mit 503 ab
# (fail-closed, siehe BATCH3_LEAD_TRACKING.md).
RECAPTCHA_SECRET_KEY=

# Optional. Score-Grenzwert 0..1, Default 0.5. Ungueltige Werte fallen auf 0.5 zurueck.
# RECAPTCHA_MIN_SCORE=0.5

# Optional. Kommaliste der Hostnames, die Google in der siteverify-Antwort
# melden darf. Default: alexander-ergart.de,localhost
# Preview-Deployments (*.vercel.app) sind absichtlich NICHT enthalten.
# RECAPTCHA_ALLOWED_HOSTNAMES=alexander-ergart.de,localhost

# ---------------------------------------------------------------------------
# Lead-Zustellung
# ---------------------------------------------------------------------------
# Pflicht. Die Action-URL steht im Formspark-Dashboard unter "How-to".
# In Vercel unter Environment Variables setzen. Der Platzhalter sendet nichts.
FORMSPARK_ENDPOINT=https://submit-form.com/YOUR_FORM_ID

# Optional. Zustellversuche pro IP und 10 Minuten, Default 5.
# LEAD_RATE_MAX=5

# ---------------------------------------------------------------------------
# Lokale Entwicklung
# ---------------------------------------------------------------------------
# Optional. Zeigt auf /karriere Beispiel-Stellen aus src/lib/jobs-fixture.ts
# statt der Sanity-Daten. Nur lokal setzen, nie auf Vercel.
# JOBS_FIXTURE=1
