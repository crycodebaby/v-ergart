# Analytics (Plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=alexander-ergart.de

# ---------------------------------------------------------------------------
# reCAPTCHA v3
# ---------------------------------------------------------------------------
# Site Key: oeffentlich, wird NUR im Browser verwendet (src/hooks/useRecaptcha.ts).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Secret Key: NUR serverseitig (src/app/api/leads/fenster/route.ts).
# PFLICHT - ohne diesen Wert weist /api/leads/fenster jeden Lead mit 503 ab
# (fail-closed, siehe BATCH3_LEAD_TRACKING.md).
RECAPTCHA_SECRET_KEY=

# Optional. Score-Grenzwert 0..1, Default 0.5. Ungueltige Werte fallen auf 0.5 zurueck.
# RECAPTCHA_MIN_SCORE=0.5

# Optional. Kommaliste der Hostnames, die Google in der siteverify-Antwort
# melden darf. Default: alexander-ergart.de,localhost
# Preview-Deployments (*.vercel.app) sind absichtlich NICHT enthalten.
# RECAPTCHA_ALLOWED_HOSTNAMES=alexander-ergart.de,localhost

# ---------------------------------------------------------------------------
# Lead-Zustellung
# ---------------------------------------------------------------------------
# Optional. Default ist der bestehende Formcarry-Endpunkt.
# FORMCARRY_ENDPOINT=

# Optional. Zustellversuche pro IP und 10 Minuten, Default 5.
# LEAD_RATE_MAX=5
